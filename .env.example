# ─────────────────────────────────────────
#  GamerThumb — Variáveis de ambiente
#  Copie este arquivo para .env e preencha
# ─────────────────────────────────────────

# SUPABASE (https://supabase.com → seu projeto → Settings → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_KEY=sua-service-key-aqui

# SERVIDOR
PORT=3000
NODE_ENV=development

# OPENAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-sua-chave-aqui

# STRIPE (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_sua-chave-aqui
STRIPE_WEBHOOK_SECRET=whsec_sua-chave-aqui
STRIPE_PRICE_CRIADOR=price_id_plano_criador
STRIPE_PRICE_PRO=price_id_plano_pro

# URL do app
APP_URL=http://localhost:3000
